<?xml version="1.0" encoding="UTF-16"?>
<!--
  Task Scheduler definition: monthly weird-baby D1 / guestbook backup.

  Import (operator, from an elevated PowerShell, after editing the two TODO
  placeholders below):

    schtasks /create /tn "WeirdBaby D1 Guestbook Backup" `
      /xml "C:\AI\Projects\weird-baby-museum\tools\weird-baby-d1-backup.task.xml"

  Runs on the 1st of every month at 09:00 local. "StartWhenAvailable" means a
  run missed because the laptop was off fires as soon as the machine is next on.
  LogonType=InteractiveToken => runs under your account when you are logged on,
  with NO stored password. See backups/README.md > "Automated backups".
-->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Monthly read-only export of the weird-baby D1 database (guestbook + visits) to backups/, with a local git commit. Operator pushes.</Description>
    <URI>\WeirdBaby D1 Guestbook Backup</URI>
  </RegistrationInfo>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2026-06-01T09:00:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByMonth>
        <DaysOfMonth>
          <Day>1</Day>
        </DaysOfMonth>
        <Months>
          <January /><February /><March /><April /><May /><June />
          <July /><August /><September /><October /><November /><December />
        </Months>
      </ScheduleByMonth>
    </CalendarTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <!-- TODO(operator): replace with your account, e.g. LAPTOP\Mike .
           Or omit and pass /ru "<you>" to schtasks at import time. -->
      <UserId>TODO\\REPLACE_WITH_YOUR_USER</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>true</RunOnlyIfNetworkAvailable>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT30M</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>powershell.exe</Command>
      <Arguments>-NoProfile -ExecutionPolicy Bypass -File "C:\AI\Projects\weird-baby-museum\tools\backup-guestbook-scheduled.ps1"</Arguments>
      <WorkingDirectory>C:\AI\Projects\weird-baby-museum</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
